# =========================================================================
# AI 游戏平台 · 唯一配置样板（全部环境变量的清单；复制为 .env 使用）
#
#   本地开发：cp apps/.env.example apps/.env
#   服务器  ：cp apps/.env.example /srv/ai-game-platform/.env（chmod 600），
#             再按下表改这 12 项，其余保持一致：
#
#   ⚙️ 服务器需改
#     PLATFORM_DATABASE_URL                本机 PG → postgres-platform:5432（平台库账号口令）
#     PG_ADMIN_HOST / PG_ADMIN_PORT        公网 IP:10050 → postgres-games:5432
#     API_INTERNAL_URL                     http://api:8000
#     JWKS_URL                             http://api:8000/.well-known/jwks.json
#     JWT_ISSUER                           http(s)://<域名>
#     CORS_ORIGINS                         http(s)://<域名>
#     LLM_PROVIDER / LLM_MODEL_ID /
#     LLM_BASE_URL / LLM_API_KEY           生产模型预设
#     LANGSMITH_TRACING / PROJECT          生产项目
#     POSTGRES_GAMES_PASSWORD              服务器随机口令
#     POSTGRES_PLATFORM_PASSWORD           服务器随机口令
#     LANGGRAPH_PG_PASSWORD                服务器随机口令
#
#   密钥类（INTERNAL_TOKEN / E2B / COS / TENCENT / LLM / LANGSMITH /
#   GAME_DB_PASSWORD_MASTER_SECRET / PG_ADMIN_PASSWORD）本地与服务器填真实值。
# =========================================================================

# ==================== api ====================

# --- 数据库（⚙️ 服务器：PLATFORM_DATABASE_URL、PG_ADMIN_HOST/PORT 需改）---
PLATFORM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/aigame_platform?sslmode=disable
PG_ADMIN_HOST=43.129.212.75
PG_ADMIN_PORT=10050
PG_ADMIN_USER=aigame_admin
PG_ADMIN_PASSWORD=CHANGE_ME
PG_ADMIN_DB=postgres
GAME_DB_HOST=43.129.212.75
GAME_DB_PORT=10050
# 必须 no-verify：游戏侧 node pg 把 require 当 verify-full，自签证书会连不上
GAME_DB_SSLMODE=no-verify
GAME_DB_PASSWORD_MASTER_SECRET=CHANGE_ME

# --- JWT ---
JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
JWT_ISSUER=https://api.aigame.local
JWT_AUDIENCE=aigame-platform
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- 内部令牌 ---
INTERNAL_TOKEN=CHANGE_ME

# --- AGS 沙盒 ---
E2B_DOMAIN=ap-shanghai.tencentags.com
E2B_API_KEY=e2b_CHANGE_ME
AGS_TEMPLATE=sdt-3yg7vydi
SANDBOX_TIMEOUT_SECONDS=3600

# --- COS ---
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COS_REGION=ap-shanghai
COS_BUCKET=ai-game-platform-test-1327210567
COS_GAMES_PREFIX=games

# --- CloudBase 云托管 ---
TENCENT_SECRET_ID=CHANGE_ME
TENCENT_SECRET_KEY=CHANGE_ME
TCB_ENV_ID=test-agent-d5ghby2pe53e38f28
TCB_REGION=ap-shanghai

# ==================== agent ====================

# --- 模型（⚙️ 服务器：生产预设）---
LLM_PROVIDER=deepseek
LLM_MODEL_ID=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=CHANGE_ME

# --- LangSmith（⚙️ 服务器：TRACING/PROJECT 用生产值）---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_PROJECT=ai-game-platform-dev

# --- 平台对接（⚙️ 服务器：容器内网地址）---
API_INTERNAL_URL=http://127.0.0.1:8000
JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json

# ==================== frontend ====================
# CORS_ORIGINS 服务器改为 http(s)://<域名>
CORS_ORIGINS=http://localhost:5173

# --- frontent-test-1（VITE_ 前缀会暴露给浏览器）---
VITE_API_BASE_URL=/api/v1
VITE_LG_BASE_URL=/lg
VITE_LG_ASSISTANT_ID=game
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_LG_PROXY_TARGET=http://127.0.0.1:2024

# ==================== 本地开发 PG（apps/docker-compose.yml）====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aigame_platform

# ==================== 服务器部署专用（本地开发用不到）====================
API_IMAGE=ghcr.io/zzbazzzbaz/ai-game-platform-v2/api
WEB_IMAGE=ghcr.io/zzbazzzbaz/ai-game-platform-v2/web
AGENT_IMAGE=ghcr.io/zzbazzzbaz/ai-game-platform-v2/agent
TAG=main
POSTGRES_GAMES_USER=postgres
POSTGRES_GAMES_PASSWORD=CHANGE_ME
POSTGRES_PLATFORM_USER=aigame_platform
POSTGRES_PLATFORM_PASSWORD=CHANGE_ME
POSTGRES_PLATFORM_DB=aigame_platform
LANGGRAPH_PG_PASSWORD=CHANGE_ME
