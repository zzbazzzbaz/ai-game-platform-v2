# AGS（Agent Sandbox）E2B 兼容接入配置
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交。

# E2B 兼容 endpoint 域名（只填域名，不带 https://）
# 广州: ap-guangzhou.tencentags.com
# 上海: ap-shanghai.tencentags.com
E2B_DOMAIN=ap-shanghai.tencentags.com

# 控制台创建的 API Key（e2b_ 前缀）
E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 控制台创建的「All-In-One 沙箱」工具名称或 ToolId（sdt-...），作为 Sandbox.create(template=...)
# 工具类型选 aio（预置类型，无需自定义镜像）；网络模式选 PUBLIC。
# E2B_DOMAIN 与 AGS_TEMPLATE 必须属于同一地域
AGS_TEMPLATE=all-in-one-v1
