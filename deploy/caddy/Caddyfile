# 系统级 Caddy：/etc/caddy/Caddyfile → /srv/ai-game-platform/caddy/Caddyfile
# 变量来自 systemd drop-in 的 EnvironmentFile=/srv/ai-game-platform/caddy.env（DOMAIN / ACME_EMAIL）
# 上游：127.0.0.1:8081 web ｜ 8082 api ｜ 8083 agent
#
# HTTPS：证书由 Caddy 自动申请并续期（需 80/443 都可从公网访问）；80 端口自动 308 跳转到 https。
# 若哪天 443 又被关掉（证书无法续期），临时切回 HTTP 三步：加回 auto_https off、
# 站点地址写成 http://{$DOMAIN}、服务器 .env 的 JWT_ISSUER / CORS_ORIGINS 改回 http://。

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8082
	}

	# 不能写成 /.well-known/*：会代理走 ACME http-01 挑战路径
	handle /.well-known/jwks.json {
		reverse_proxy 127.0.0.1:8082
	}

	handle /health {
		reverse_proxy 127.0.0.1:8082
	}

	handle_path /lg* {
		reverse_proxy 127.0.0.1:8083 {
			flush_interval -1
			transport http {
				dial_timeout 10s
				response_header_timeout 300s
				read_timeout 0
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8081
	}

	header -Server

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
